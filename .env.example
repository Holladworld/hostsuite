# ─── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Payment providers (server-only) ──────────────────────
PAYSTACK_SECRET_KEY=your-paystack-secret-key
FLW_SECRET_KEY=your-flutterwave-secret-key
FLW_SECRET_HASH=your-flutterwave-webhook-secret-hash

# ─── AI gateway (server-only) ─────────────────────────────
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=your-model
AI_API_KEY=your-server-side-ai-key
OPEN_THORN_BASE_URL=https://your-openthorn.example.com

# ─── Provider adapter (server-only) ───────────────────────
# Use whogohost only after your reseller account/API credentials are ready.
# Never use the mock adapter for customer-facing production data.
HOSTING_PROVIDER=unconfigured
WHOGOHOST_API_BASE_URL=https://www.whogohost.com/host/modules/addons/DomainsReseller/api/index.php
WHOGOHOST_API_KEY=server-only-domain-reseller-api-key
WHOGOHOST_API_EMAIL=your-whogohost-reseller-email
# Required for paid domain registration; choose the nameservers assigned to
# your reseller/hosting setup.
WHOGOHOST_DEFAULT_NS1=
WHOGOHOST_DEFAULT_NS2=
# The current public knowledgebase documents availability as an API action but
# does not expose a stable route/parameter contract. Configure the exact path
# from your reseller API documentation/account rather than guessing it.
WHOGOHOST_DOMAIN_AVAILABILITY_PATH=
# Hosting/DirectAdmin automation credentials should be added only after the
# exact reseller/WHM automation contract is verified with WhoGoHost.

# ─── Email (Nodemailer / Gmail SMTP) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vobels.co@gmail.com
SMTP_PASS=your_app_password
LEAD_RECIPIENT_EMAIL=vobels.co@gmail.com

# ─── Public WhatsApp desk ──────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=2348142243764
