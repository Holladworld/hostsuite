# ─── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Never expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Payment providers (server-only) ──────────────────────
PAYSTACK_SECRET_KEY=your-paystack-secret-key
FLW_SECRET_KEY=your-flutterwave-secret-key
FLW_SECRET_HASH=your-flutterwave-webhook-secret-hash

# ─── AI gateway (server-only) ─────────────────────────────
# Compatible with OpenAI-style /chat/completions endpoints.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=your-model
AI_API_KEY=your-server-side-ai-key

# Full agentic builder, once OpenThorn is deployed separately.
OPEN_THORN_BASE_URL=https://your-openthorn.example.com

# ─── Provider adapter ─────────────────────────────────────
# Use mock until the reseller API is verified.
HOSTING_PROVIDER=mock
# WHOGOHOST_API_BASE_URL=https://provider.example.com/api
# WHOGOHOST_API_KEY=server-only-provider-key
# WHOGOHOST_API_SECRET=server-only-provider-secret
# WHOGOHOST_RESELLER_ID=your-reseller-id

# ─── Email (Nodemailer / Gmail SMTP) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vobels.co@gmail.com
SMTP_PASS=your_app_password
LEAD_RECIPIENT_EMAIL=vobels.co@gmail.com

# ─── Public WhatsApp desk ──────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=2348142243764
