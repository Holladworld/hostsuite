# ─── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Email (Nodemailer / Gmail SMTP) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-app-password
LEAD_RECIPIENT_EMAIL=your-recipient@example.com

# ─── Public WhatsApp desk ──────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=2340000000000

# ─── AI provider (server only) ────────────────────────────
# Compatible with OpenAI-style /v1/chat/completions providers.
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=your-model-name

# ─── Payments (server only) ───────────────────────────────
PAYSTACK_SECRET_KEY=your-paystack-secret-key
FLW_SECRET_KEY=your-flutterwave-secret-key
FLW_SECRET_HASH=your-flutterwave-webhook-secret
